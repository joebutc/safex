<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650" prefWidth="900" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.LegalOnboardPage">

    <!-- ===== HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="app-header">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <Button onAction="#handleSettingsMenu" styleClass="secondary-button" text="← Back" />
            <Label styleClass="app-header-title" text="Privacy &amp; Terms" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" pannable="true" style="-fx-background-color: transparent;">
            <StackPane alignment="TOP_CENTER">
                <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                <VBox fx:id="contentContainer" maxWidth="620" spacing="12" styleClass="card,card-padding,card-flat">

                    <!-- ═══════════════ PRIVACY SECTION ═══════════════ -->
                    <VBox fx:id="privacySection" spacing="12">

                        <Label styleClass="legal-title" text="Privacy Policy Summary" />
                        <Label maxWidth="520" styleClass="muted-text,legal-intro" text="This summary provides key points from our Privacy Notice, but you can find out more details about any of these topics by using the table of contents in the full notice or reading the full sections." wrapText="true" />

                        <!-- Q&A pairs -->
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What personal information do we process?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" When you visit, use, or navigate our Services, we may process personal information depending on how you interact with us and the Services, the choices you make, and the products and features you use. Learn more about personal information we collect in Section 1." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Do we process any sensitive personal information?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" Some of the information we process may be considered special category data (for example health data). We process special category data only where we have a lawful basis and, for health data, only where we have your explicit consent or processing is otherwise permitted under applicable law (for example, where necessary for the provision of health or social care). See Section 3 and Section 10." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Do we collect any information from third parties?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" We may receive limited personal and health-related information from healthcare providers, clinics, or laboratories when you use the Services to book tests, receive results, or manage treatment. See Section 1 and Section 4 for details." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="How do we process your information?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" We process your information to provide, improve, and administer our Services, communicate with you, for safety and fraud prevention, and to comply with law. We may also process your information for other purposes with your consent. See Section 2." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="In what situations and with which parties do we share personal information?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" We may share information with healthcare providers, service partners, and in limited situations described in Section 4." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="How do we keep your information safe?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" We use organisational and technical measures to protect your personal information, but cannot guarantee absolute security. See Section 6." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What are your rights?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" Depending where you live, you have rights to access, correct, delete, and restrict processing of your personal data; and to withdraw consent where processing is based on consent. See Section 8." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="How do you exercise your rights?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" The easiest way to exercise your rights is through the app's privacy and data controls, or by contacting us at support@safex.com. We will consider and act upon any request in accordance with applicable data protection laws. See Section 13." wrapText="true" />
                        </VBox>

                        <!-- PDF row -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <padding><Insets bottom="6" top="6" /></padding>
                            <Label text="Privacy Notice (full) (PDF)" />
                            <Button onAction="#openPrivacyPdf" styleClass="secondary-button" text="Open PDF" />
                        </HBox>

                        <!-- Continue button -->
                        <Button maxWidth="520" onAction="#handleContinue" styleClass="primary-button" text="By continuing, you acknowledge that you have read our Privacy Policy." wrapText="true">
                            <HBox.margin><Insets top="12" /></HBox.margin>
                        </Button>
                    </VBox>

                    <!-- ═══════════════ TERMS SECTION (hidden initially) ═══════════════ -->
                    <VBox fx:id="termsSection" managed="false" spacing="12" visible="false">

                        <Label styleClass="legal-title" text="Terms &amp; Conditions Summary" />
                        <Label maxWidth="520" styleClass="legal-intro" text="This summary provides key points from our Terms of Use, but you can find out more details about any of these topics by using the table of contents in the full Terms or reading the full sections." wrapText="true" />

                        <!-- Q&A pairs -->
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What are these Terms and who do they apply to?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" These Terms form a legally binding agreement between you and SafeX Ltd and apply to your access to and use of the SafeX mobile application and related services. See &quot;Agreement to Our Legal Terms&quot;." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What do the Services do (and not do)?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" The Services support test booking, delivery of test results, prescription management, secure notifications, and private communications with clinics/healthcare professionals. The Services do not provide public posting, public social feeds, or public comments. See Section 1." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Who can use the Services?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" You must be at least 18 years old, have legal capacity to enter into these Terms, and provide accurate information. See Section 3." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What are the main rules for using the Services?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" You must not misuse the Services (for example, unlawful activity, impersonation, interfering with systems or accounts, security circumvention, malware, spam, scraping/bots without permission, or reverse engineering). See Section 4." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Who owns the Services and what rights do you get?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" SafeX (and its licensors) own the Services and associated content. You receive a limited, non-exclusive, non-transferable, revocable licence to access and use the Services for personal, non-commercial use, subject to these Terms. See Section 2." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What about content you provide and feedback you submit?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" You keep your rights in the content you provide, but you grant the rights needed to operate the Services. If you submit feedback, you grant SafeX a broad licence to use it (including to improve the Services). See Section 5." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Can SafeX suspend or terminate access?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" SafeX may monitor for compliance, restrict or terminate access, and take action if these Terms are violated. Termination ends your right to use the Services, and certain sections continue to apply. See Sections 6 and 7." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Can the Services or Terms change?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" The Services may be modified, interrupted, or discontinued, and the Terms may be updated from time to time. Material changes are indicated by updating the &quot;Last updated&quot; date and providing notice where required. See &quot;Agreement to Our Legal Terms&quot; and Section 8." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What law applies and how are disputes handled?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" These Terms are governed by the laws of England and Wales, and disputes are generally handled through informal resolution first, then courts in England and Wales (without limiting urgent injunctive relief). See Sections 9 and 10." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Is the Services' information medical advice?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" No. Information and features are for general informational purposes and are not a substitute for professional medical advice, diagnosis, or treatment. SafeX is not a healthcare provider. See Section 12." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="What warranties and liabilities are disclaimed/limited?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" The Services are provided &quot;as is&quot; and &quot;as available&quot;, warranties are disclaimed to the maximum extent permitted by law, and liability is limited (including a cap on aggregate liability), subject to applicable law. See Sections 13 and 14." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="Do you have to indemnify SafeX?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" You agree to indemnify and hold SafeX harmless from certain claims and costs arising from your use of the Services and violations of these Terms. See Section 15." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="How is user data handled?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" SafeX maintains data you transmit for operating/providing/improving the Services and performs routine backups, with limits on liability for loss/corruption. Personal data use is governed by the Privacy Policy. See Section 16." wrapText="true" />
                        </VBox>
                        <VBox maxWidth="520" spacing="4">
                            <Label styleClass="legal-question" text="How can you contact SafeX?" wrapText="true" />
                            <Label styleClass="legal-answer" text=" Email support@safex.com or write to SafeX Ltd, London, United Kingdom (for notices only). See Section 19." wrapText="true" />
                        </VBox>

                        <!-- PDF row -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <padding><Insets bottom="6" top="6" /></padding>
                            <Label text="Terms (full) (PDF)" />
                            <Button onAction="#openTermsPdf" styleClass="secondary-button" text="Open PDF" />
                        </HBox>

                        <!-- I Agree button -->
                        <Button defaultButton="true" maxWidth="520" onAction="#handleSettingsMenu" styleClass="primary-button" text="I Agree" wrapText="true">
                            <HBox.margin><Insets top="12" /></HBox.margin>
                        </Button>
                    </VBox>

                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
