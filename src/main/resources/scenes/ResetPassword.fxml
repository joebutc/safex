<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.view.AccountRecoveryController">
    <left>
        <VBox alignment="CENTER"
              prefWidth="310"
              minWidth="310"
              maxWidth="310"
              spacing="20"
              style="-fx-background-color: #0A0A0A;">
            <padding>
                <Insets top="48" right="28" bottom="48" left="28"/>
            </padding>
            <ImageView fitWidth="254" fitHeight="200" preserveRatio="true">
                <Image url="@../images/safex_logo.png"/>
            </ImageView>
            <Label text="Set a strong password&#10;and get back in."
                   wrapText="true"
                   maxWidth="240"
                   style="-fx-font-size:13px;-fx-text-fill:#94A3B8;"/>
        </VBox>
    </left>

    <center>
        <StackPane style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <VBox alignment="CENTER_LEFT"
                  spacing="14"
                  maxWidth="420">
                <styleClass>
                    <String fx:value="card"/>
                    <String fx:value="card-padding"/>
                </styleClass>

                <Label text="Create a new password"/>
                <Label fx:id="resetSubtitleLabel"
                       text="Choose a new password for your account."
                       wrapText="true"
                       styleClass="muted-text"/>

                <VBox spacing="4">
                    <Label text="New password"/>
                    <PasswordField fx:id="newPasswordField"
                                   promptText="Enter a new password"
                                   maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Confirm new password"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Confirm your new password"
                                   maxWidth="Infinity"/>
                </VBox>

                <Label fx:id="resetStatusLabel"
                       visible="false"
                       managed="false"
                       wrapText="true"/>

                <Button text="Reset password"
                        minHeight="42"
                        maxWidth="Infinity"
                        onAction="#handleResetPassword"
                        styleClass="primary-button"/>

                <Button text="Back to login"
                        onAction="#handleBackToLogin"
                        styleClass="link-button"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
