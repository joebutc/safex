<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650" prefWidth="900" styleClass="partner-notify-shell" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.PartnerNotifyPage">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="app-header">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <Button onAction="#handleHome" styleClass="icon-button" stylesheets="@../styles/app.css">
            <graphic>
               <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../images/Home.png" />
                  </image>
               </ImageView>
            </graphic></Button>
            <Label styleClass="app-header-title" text="Notify Partners" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER" spacing="12">
                <Label fx:id="promptLabel" maxWidth="1.7976931348623157E308" prefHeight="37.0" prefWidth="704.0" styleClass="partner-prompt-pill" text="Send anonymous email notifications to chosen partners." wrapText="true" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="10" left="16" right="16" top="10" />
                    </padding>
                </Label>
                <Button fx:id="addContactButton" focusTraversable="false" onAction="#handleAddContact" styleClass="partner-action-pill">
                    <padding>
                        <Insets bottom="12" left="12" right="12" top="12" />
                    </padding>
                    <graphic>
                        <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                            <Image url="@../images/+.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" pannable="true" styleClass="list-scroll-pane" VBox.vgrow="ALWAYS">
                <VBox fx:id="contactsContainer" spacing="12">
                    <padding>
                        <Insets bottom="12" left="12" right="12" top="12" />
                    </padding>
                </VBox>
            </ScrollPane>

            <HBox alignment="CENTER" spacing="16" styleClass="card">
                <padding>
                    <Insets bottom="18" left="18" right="18" top="18" />
                </padding>
                <Label maxWidth="1.7976931348623157E308" text="Note: the following message will be sent anonymously to all contacts in the list above." wrapText="true" HBox.hgrow="ALWAYS" />
                <Button fx:id="notifyButton" onAction="#handleNotify" styleClass="partner-action-pill" text="Notify">
                    <graphic>
                        <ImageView fitHeight="25" fitWidth="25" preserveRatio="true">
                            <Image url="@../images/Bell.png" />
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>
