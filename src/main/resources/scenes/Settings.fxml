<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="app.view.SettingsPage">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="app-header">
            <padding>
                <Insets left="10" right="10" />
            </padding>
            <Button fx:id="homeButton" onAction="#handleSettingsMenu" styleClass="icon-button">
                <graphic>
                    <ImageView fx:id="homeIcon" fitHeight="28" fitWidth="28">
                        <Image url="@../images/Home.png" />
                    </ImageView>
                </graphic>
            </Button>
            <Label styleClass="app-header-title" text="Settings" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="edge-to-edge">
            <VBox spacing="16" alignment="TOP_CENTER">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20" />
                </padding>

            <Label text="Your Data" styleClass="settings-section-header"/>
            <FlowPane hgap="14" vgap="14" alignment="TOP_CENTER" prefWrapLength="940">
                <Button onAction="#handleDataCollected" styleClass="card-setting" prefWidth="300" prefHeight="100">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER_LEFT" prefWidth="268">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="View your personal data" styleClass="card-setting-title"/>
                                <Label text="See all data we have stored, export as CSV" styleClass="card-setting-subtitle" wrapText="true"/>
                            </VBox>
                            <Label text="›" styleClass="card-chevron"/>
                        </HBox>
                    </graphic>
                </Button>
            </FlowPane>

            <Label text="Manage Your Preferences" styleClass="settings-section-header"/>
            <FlowPane hgap="14" vgap="14" alignment="TOP_CENTER" prefWrapLength="940">
                <Button onAction="#handleAccess" styleClass="card-setting" prefWidth="300" prefHeight="100">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER_LEFT" prefWidth="268">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Who can access your data" styleClass="card-setting-title"/>
                                <Label text="Choose which parties can view your info" styleClass="card-setting-subtitle" wrapText="true"/>
                            </VBox>
                            <Label text="›" styleClass="card-chevron"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button onAction="#handleRetention" styleClass="card-setting" prefWidth="300" prefHeight="100">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER_LEFT" prefWidth="268">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Data retention period" styleClass="card-setting-title"/>
                                <Label text="Set how long health data is kept" styleClass="card-setting-subtitle" wrapText="true"/>
                            </VBox>
                            <Label text="›" styleClass="card-chevron"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button onAction="#handleTestingPermissions" styleClass="card-setting" prefWidth="300" prefHeight="100">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER_LEFT" prefWidth="268">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Testing data permissions" styleClass="card-setting-title"/>
                                <Label text="Reminders and doctor sharing" styleClass="card-setting-subtitle" wrapText="true"/>
                            </VBox>
                            <Label text="›" styleClass="card-chevron"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button onAction="#handleTreatmentPermissions" styleClass="card-setting" prefWidth="300" prefHeight="100">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER_LEFT" prefWidth="268">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Treatment data permissions" styleClass="card-setting-title"/>
                                <Label text="Medication reminders and clinic access" styleClass="card-setting-subtitle" wrapText="true"/>
                            </VBox>
                            <Label text="›" styleClass="card-chevron"/>
                        </HBox>
                    </graphic>
                </Button>
            </FlowPane>

            <Label text="Learn More" styleClass="settings-section-header"/>
            <FlowPane hgap="14" vgap="14" alignment="TOP_CENTER" prefWrapLength="940">
                <Button onAction="#handlePrivacyPolicy" styleClass="card-info" prefWidth="300" prefHeight="90">
                    <graphic>
                        <VBox spacing="4" prefWidth="268">
                            <Label text="Privacy Policy" styleClass="card-info-title"/>
                            <Label text="How we collect, use and protect your data" styleClass="card-info-subtitle" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button onAction="#handleTermsConditions" styleClass="card-info" prefWidth="300" prefHeight="90">
                    <graphic>
                        <VBox spacing="4" prefWidth="268">
                            <Label text="Terms &amp; Conditions" styleClass="card-info-title"/>
                            <Label text="Your agreement with SafeX" styleClass="card-info-subtitle" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button onAction="#handleWhyUsed" styleClass="card-info" prefWidth="300" prefHeight="90">
                    <graphic>
                        <VBox spacing="4" prefWidth="268">
                            <Label text="Why your data is used" styleClass="card-info-title"/>
                            <Label text="To improve services and ensure security" styleClass="card-info-subtitle" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button onAction="#handleRights" styleClass="card-info" prefWidth="300" prefHeight="90">
                    <graphic>
                        <VBox spacing="4" prefWidth="268">
                            <Label text="Your rights" styleClass="card-info-title"/>
                            <Label text="Access, modify, or delete your data" styleClass="card-info-subtitle" wrapText="true"/>
                        </VBox>
                    </graphic>
                </Button>
            </FlowPane>

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
