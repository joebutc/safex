<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.view.StiTestTrackerPage"
            prefHeight="650"
            prefWidth="900"
            styleClass="sti-tracker-shell">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="app-header">
            <Button fx:id="homeButton" styleClass="icon-button">
                <graphic>
                    <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                        <Image url="@../images/Home.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Label styleClass="app-header-title" text="Track Your Tests"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets bottom="24" left="24" right="24" top="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="sti-tracker-caption"
                       text="Keep a private record of your STI testing history. All data is stored locally on this device."
                       wrapText="true"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="addButton"
                        minHeight="40"
                        styleClass="primary-button"
                        text="+ Log New Test"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="list-header-row">
                <padding>
                    <Insets bottom="4" left="16" right="16" top="4"/>
                </padding>
                <Label minWidth="110" styleClass="list-header-label" text="Date"/>
                <Label minWidth="160" styleClass="list-header-label" text="Test Type"/>
                <Label minWidth="100" styleClass="list-header-label" text="Result"/>
                <Label styleClass="list-header-label" text="Notes" HBox.hgrow="ALWAYS"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="list-scroll-pane">
                <VBox spacing="8">
                    <Label fx:id="emptyStateLabel"
                           managed="false"
                           styleClass="sti-empty-state"
                           text="No tests logged yet. Click '+ Log New Test' to add your first entry."
                           visible="false"
                           wrapText="true"/>
                    <VBox fx:id="testListContainer" spacing="8">
                        <padding>
                            <Insets bottom="16"/>
                        </padding>
                    </VBox>
                    <padding>
                        <Insets bottom="16"/>
                    </padding>
                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
