<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="app.view.DashboardPage" minWidth="900" minHeight="650" style="-fx-background-color: #F8FAFC;">
    <!-- ================= HEADER ================= -->
    <top>
        <BorderPane styleClass="app-header">

            <left>
                <Label text="SafeX"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
            </left>

            <center>
                <Label fx:id="welcomeLabel"
                       style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #334155;"/>
            </center>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Button fx:id="bellButton"
                            onAction="#handleNotifications"
                            styleClass="icon-button"/>
                    <Button text="Logout"
                            onAction="#handleLogout">
                        <styleClass>
                            <String fx:value="secondary-button"/>
                        </styleClass>
                    </Button>
                </HBox>
            </right>

        </BorderPane>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <VBox spacing="18" padding="24">
            <FlowPane fx:id="cardContainer"
                      hgap="18"
                      vgap="18"
                      alignment="TOP_CENTER"
                      prefWrapLength="1000"/>
        </VBox>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox spacing="10"
              padding="12 24 18 24"
              alignment="CENTER_LEFT">

            <Label text="SafeX - Your privacy is our priority"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="v0.0.1"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>

        </HBox>
    </bottom>

</BorderPane>
