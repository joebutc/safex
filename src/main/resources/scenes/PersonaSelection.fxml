<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.view.PersonaSelectionController"
            style="-fx-background-color: #F8FAFC;">

    <center>
        <VBox spacing="32" alignment="CENTER">
            <padding>
                <Insets top="48" right="48" bottom="48" left="48"/>
            </padding>

            <VBox spacing="8" alignment="CENTER">
                <Label text="Which persona best suits your needs?" styleClass="onboarding-title"/>
                <Label text="Choose a privacy profile to get started quickly."
                       styleClass="onboarding-subtitle" wrapText="true"/>
            </VBox>

            <HBox spacing="24" alignment="CENTER">

                <VBox fx:id="anonymousCard" spacing="16" alignment="TOP_CENTER"
                      styleClass="persona-card" onMouseClicked="#selectAnonymous">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <StackPane styleClass="persona-icon-container,persona-icon-anonymous">
                        <SVGPath content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"
                                 styleClass="persona-icon"/>
                    </StackPane>

                    <Label text="Anonymous" styleClass="persona-title"/>

                    <VBox spacing="8" alignment="TOP_LEFT">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="Data retained for 30 days" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="No data sharing with third parties" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="No reminders or notifications" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox fx:id="balancedCard" spacing="16" alignment="TOP_CENTER"
                      styleClass="persona-card" onMouseClicked="#selectBalanced">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <StackPane styleClass="persona-icon-container,persona-icon-balanced">
                        <SVGPath content="M12 3c-1.27 0-2.4.8-2.82 2H3v2h1.95L2 14c-.47 2 1 4 3.5 4s4.06-2 3.5-4L6.05 7h3.12c.33.85 1.01 1.53 1.86 1.86v10.14H9v2h6v-2h-2V8.86c.85-.33 1.53-1.01 1.86-1.86h3.12L15 14c-.47 2 1 4 3.5 4s4.06-2 3.5-4l-2.95-7H21V5h-6.18C14.4 3.8 13.27 3 12 3zm0 2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM5.5 10.25l1.25 3h-2.5l1.25-3zm13 0l1.25 3h-2.5l1.25-3z"
                                 styleClass="persona-icon"/>
                    </StackPane>

                    <Label text="Balanced" styleClass="persona-title"/>

                    <VBox spacing="8" alignment="TOP_LEFT">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="Data retained for 90 days" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="Support staff access only" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="Test and treatment reminders enabled" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox fx:id="connectedCard" spacing="16" alignment="TOP_CENTER"
                      styleClass="persona-card" onMouseClicked="#selectConnected">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <StackPane styleClass="persona-icon-container,persona-icon-connected">
                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                 styleClass="persona-icon"/>
                    </StackPane>

                    <Label text="Connected" styleClass="persona-title"/>

                    <VBox spacing="8" alignment="TOP_LEFT">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="Data retained for 180 days" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="Analytics and partner sharing enabled" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="•" styleClass="persona-bullet"/>
                            <Label text="Clinic integration and doctor sharing" styleClass="persona-feature" wrapText="true"/>
                        </HBox>
                    </VBox>
                </VBox>

            </HBox>

            <Label text="You can fine-tune the details later in Settings." styleClass="muted-text"/>

            <Button fx:id="continueBtn" text="Continue to SafeX" styleClass="primary-button"
                    onAction="#handleContinue" prefWidth="200" disable="true"/>

        </VBox>
    </center>

</BorderPane>
