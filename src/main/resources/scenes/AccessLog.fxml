<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480"
      spacing="16"
      styleClass="dialog-shell"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="app.view.AccessLogController">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24"/>
    </padding>
    <Label styleClass="dialog-title" text="Who has accessed your data"/>
    <Label styleClass="dialog-copy" text="This log shows when clinics have viewed or modified your treatment data." wrapText="true"/>
    <ScrollPane fitToWidth="true" prefHeight="300" styleClass="log-scroll-pane">
        <VBox fx:id="logContainer" spacing="8">
            <padding>
                <Insets bottom="8" left="4" right="4" top="4"/>
            </padding>
        </VBox>
    </ScrollPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="closeButton" onAction="#handleClose" styleClass="primary-button" text="Close"/>
    </HBox>
</VBox>
