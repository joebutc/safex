<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" spacing="16" styleClass="sti-test-row"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.view.StiTestRowController">
    <Label fx:id="dateLabel" minWidth="110" styleClass="sti-test-date"/>
    <Label fx:id="typeLabel" minWidth="160" styleClass="sti-test-type"/>
    <Label fx:id="resultLabel" minWidth="100" styleClass="sti-result-badge"/>
    <Label fx:id="notesLabel" maxWidth="1.7976931348623157E308" textOverrun="ELLIPSIS" styleClass="sti-test-notes" HBox.hgrow="ALWAYS"/>
    <Button fx:id="deleteButton" minHeight="30" onAction="#handleDelete" styleClass="secondary-button" text="Delete"/>
</HBox>
