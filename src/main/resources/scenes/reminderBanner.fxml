<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<HBox fx:id="bannerRoot"
      alignment="CENTER_LEFT"
      maxWidth="760.0"
      prefWidth="760.0"
      spacing="16.0"
      styleClass="reminder-banner"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.NotificationBannerController">
    <padding>
        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/>
    </padding>
    <StackPane maxHeight="52.0" maxWidth="52.0" minHeight="52.0" minWidth="52.0" prefHeight="52.0" prefWidth="52.0"
               styleClass="reminder-banner-icon">
        <SVGPath content="M9.586 2.586a2 2 0 012.828 0l6 6a2 2 0 010 2.828l-3.586 3.586a2 2 0 01-2.828 0l-6-6a2 2 0 010-2.828l3.586-3.586zM11 9l4 4"
                 fill="#FFFFFF" scaleX="0.9" scaleY="0.9"/>
    </StackPane>
    <VBox spacing="4.0">
        <Label fx:id="titleLabel" styleClass="reminder-banner-title" text="Reminder"/>
        <Label fx:id="messageLabel" styleClass="reminder-banner-message" text="Don't forget to take your medication." wrapText="true"/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleClose" styleClass="reminder-banner-close">
        <graphic>
            <SVGPath content="M6.225 4.811L10 8.586l3.775-3.775 1.414 1.414L11.414 10l3.775 3.775-1.414 1.414L10 11.414l-3.775 3.775-1.414-1.414L8.586 10 4.811 6.225z"
                     fill="#C7D2FE" scaleX="0.8" scaleY="0.8"/>
        </graphic>
    </Button>
</HBox>
