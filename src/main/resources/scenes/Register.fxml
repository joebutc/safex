<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="app.view.RegisterPage">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <center>
        <StackPane>
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <VBox spacing="14" alignment="CENTER_LEFT" maxWidth="440" styleClass="card-padding">
                <Label text="Create account">
                    <font>
                        <Font name="System" size="28"/>
                    </font>
                </Label>
                <Label text="Join our secure community." wrapText="true" styleClass="muted-text"/>
                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Username">
                        <font>
                            <Font name="System" size="13"/>
                        </font>
                    </Label>
                    <TextField fx:id="usernameField" promptText="Choose a username" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Password">
                        <font>
                            <Font name="System" size="13"/>
                        </font>
                    </Label>
                    <PasswordField fx:id="passwordField" promptText="Choose a password" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4" maxWidth="Infinity">
                    <Label text="Confirm password">
                        <font>
                            <Font name="System" size="13"/>
                        </font>
                    </Label>
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" onKeyPressed="#handleEnterKey" maxWidth="Infinity"/>
                </VBox>
                <Label fx:id="feedbackLabel" wrapText="true" visible="false" managed="false"/>
                <Button onAction="#handleRegister" text="Create account" styleClass="primary-button" defaultButton="true" maxWidth="Infinity" minHeight="42"/>
                <Button onAction="#handleLoginLink" text="Already have an account? Log in" styleClass="link-button"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
