<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.view.ClinicDashboardPage"
            minWidth="900" minHeight="650" styleClass="clinic-dashboard-shell">

    <top>
        <BorderPane>
            <styleClass>
                <String fx:value="app-header"/>
                <String fx:value="clinic-dashboard-header"/>
            </styleClass>
            <left>
                <Label text="SafeX Clinic" styleClass="clinic-brand-label"/>
            </left>
            <center>
                <VBox alignment="CENTER" spacing="2">
                    <Label fx:id="welcomeLabel" styleClass="clinic-welcome-label"/>
                    <Label text="Clinical operations dashboard" styleClass="clinic-subtitle-label"/>
                </VBox>
            </center>
            <right>
                <Button text="Logout" onAction="#handleLogout">
                    <styleClass>
                        <String fx:value="secondary-button"/>
                        <String fx:value="clinic-logout-button"/>
                    </styleClass>
                </Button>
            </right>
        </BorderPane>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color:transparent;-fx-background:transparent;">
            <VBox spacing="18" alignment="CENTER">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>

                <VBox spacing="8" maxWidth="860" styleClass="clinic-hero-card">
                    <Label text="Clinic Command Center" styleClass="clinic-hero-eyebrow"/>
                    <Label text="Manage scheduling, prescriptions, and patient follow-up from one place."
                           styleClass="clinic-hero-title" wrapText="true"/>
                    <Label text="This portal is intentionally separated from the patient experience so clinic-only workflows stay obvious, efficient, and easy to navigate."
                           styleClass="clinic-hero-copy" wrapText="true"/>
                </VBox>

                <FlowPane hgap="18" vgap="18" alignment="TOP_CENTER" prefWrapLength="1000">

                    <VBox spacing="12" prefWidth="400" minWidth="360" maxWidth="520">
                        <styleClass>
                            <String fx:value="clinic-dashboard-card"/>
                            <String fx:value="clinic-dashboard-card-primary"/>
                        </styleClass>
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane prefWidth="46" prefHeight="46" minWidth="46" minHeight="46"
                                       maxWidth="46" maxHeight="46">
                                <styleClass>
                                    <String fx:value="clinic-icon-badge"/>
                                    <String fx:value="clinic-icon-badge-primary"/>
                                </styleClass>
                                <SVGPath fill="#1D4ED8" scaleX="0.9" scaleY="0.9"
                                         content="M19 3h-1V1h-2v2H8V1H6v2H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2zm0 16H5V8h14v11zm0-13H5V5h14v1z"/>
                            </StackPane>
                            <VBox spacing="6" alignment="TOP_LEFT">
                                <Label text="Clinic Schedule" styleClass="clinic-dashboard-card-title"/>
                                <Label text="Open the clinic scheduling interface."
                                       wrapText="true" maxWidth="300" styleClass="clinic-dashboard-card-copy"/>
                            </VBox>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Open Schedule" styleClass="primary-button"
                                maxWidth="Infinity" minHeight="40" onAction="#handleOpenSchedule"/>
                    </VBox>

                    <VBox spacing="12" prefWidth="400" minWidth="360" maxWidth="520" styleClass="clinic-dashboard-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane prefWidth="46" prefHeight="46" minWidth="46" minHeight="46"
                                       maxWidth="46" maxHeight="46">
                                <styleClass>
                                    <String fx:value="clinic-icon-badge"/>
                                    <String fx:value="clinic-icon-badge-patient"/>
                                </styleClass>
                                <SVGPath fill="#9D174D" scaleX="0.9" scaleY="0.9"
                                         content="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </StackPane>
                            <VBox spacing="6" alignment="TOP_LEFT">
                                <Label text="Patient Treatments" styleClass="clinic-dashboard-card-title"/>
                                <Label text="Look up a patient by username and manage their treatment plan and prescriptions."
                                       wrapText="true" maxWidth="300" styleClass="clinic-dashboard-card-copy"/>
                            </VBox>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Manage Treatments" styleClass="secondary-button"
                                maxWidth="Infinity" minHeight="40" onAction="#handleManageTreatments"/>
                    </VBox>

                    <VBox spacing="12" prefWidth="400" minWidth="360" maxWidth="520" styleClass="clinic-dashboard-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane prefWidth="46" prefHeight="46" minWidth="46" minHeight="46"
                                       maxWidth="46" maxHeight="46">
                                <styleClass>
                                    <String fx:value="clinic-icon-badge"/>
                                    <String fx:value="clinic-icon-badge-legal"/>
                                </styleClass>
                                <SVGPath fill="#4338CA" scaleX="0.9" scaleY="0.9"
                                         content="M6 2a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6H6zm8 1.5L19.5 9H14V3.5z"/>
                            </StackPane>
                            <VBox spacing="6" alignment="TOP_LEFT">
                                <Label text="Terms &amp; Conditions" styleClass="clinic-dashboard-card-title"/>
                                <Label text="Review privacy and terms documents."
                                       wrapText="true" maxWidth="300" styleClass="clinic-dashboard-card-copy"/>
                            </VBox>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="View T&amp;C" styleClass="secondary-button"
                                maxWidth="Infinity" minHeight="40" onAction="#handleLegal"/>
                    </VBox>

                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="12" right="24" bottom="18" left="24"/>
            </padding>
            <Label text="SafeX Clinic Portal" styleClass="clinic-footer-text"/>
        </HBox>
    </bottom>

</BorderPane>
