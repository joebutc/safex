<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane minHeight="650" minWidth="900" styleClass="clinic-dashboard-shell" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.ClinicDashboardPage">

    <top>
        <BorderPane>
            <styleClass>
                <String fx:value="app-header" />
                <String fx:value="clinic-dashboard-header" />
            </styleClass>
            <left>
                <Label styleClass="clinic-brand-label" text="SafeX Clinic" />
            </left>
            <center>
                <VBox alignment="CENTER" spacing="2">
                    <Label fx:id="welcomeLabel" styleClass="clinic-welcome-label" />
                    <Label styleClass="clinic-subtitle-label" text="Clinical operations dashboard" />
                </VBox>
            </center>
            <right>
                <HBox>
                    <Button mnemonicParsing="false" onAction="#handleSettingsMenu" styleClass="icon-button">
                        <graphic>
                            <SVGPath content="M19.14 12.94a7.43 7.43 0 000-1.88l2.03-1.58a.5.5 0 00.12-.64l-1.92-3.32a.5.5 0 00-.6-.22l-2.39.96a7.62 7.62 0 00-1.63-.95l-.36-2.54A.5.5 0 0013.9 2h-3.8a.5.5 0 00-.49.42l-.36 2.54c-.57.22-1.12.53-1.63.95l-2.39-.96a.5.5 0 00-.6.22L2.71 8.84a.5.5 0 00.12.64l2.03 1.58a7.43 7.43 0 000 1.88l-2.03 1.58a.5.5 0 00-.12.64l1.92 3.32a.5.5 0 00.6.22l2.39-.96c.51.42 1.06.73 1.63.95l.36 2.54a.5.5 0 00.49.42h3.8a.5.5 0 00.49-.42l.36-2.54c.57-.22 1.12-.53 1.63-.95l2.39.96a.5.5 0 00.6-.22l1.92-3.32a.5.5 0 00-.12-.64l-2.03-1.58zM12 15.5A3.5 3.5 0 1112 8a3.5 3.5 0 010 7.5z" fill="#1E293B" />
                        </graphic>
                    </Button>
                    <Button onAction="#handleLogout" text="Logout">
                        <styleClass>
                            <String fx:value="secondary-button" />
                            <String fx:value="clinic-logout-button" />
                        </styleClass>
                    </Button>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color:transparent;-fx-background:transparent;">
            <VBox alignment="CENTER" spacing="18">
                <padding>
                    <Insets bottom="24" left="24" right="24" top="24" />
                </padding>

                <VBox maxWidth="860" spacing="8" styleClass="clinic-hero-card">
                    <Label styleClass="clinic-hero-eyebrow" text="Clinic Command Center" />
                    <Label styleClass="clinic-hero-title" text="Manage scheduling, prescriptions, and patient follow-up from one place." wrapText="true" />
                    <Label styleClass="clinic-hero-copy" text="This portal is intentionally separated from the patient experience so clinic-only workflows stay obvious, efficient, and easy to navigate." wrapText="true" />
                </VBox>

                <FlowPane alignment="TOP_CENTER" hgap="18" prefWrapLength="1000" vgap="18">

                    <VBox maxWidth="520" minWidth="360" prefWidth="400" spacing="12">
                        <styleClass>
                            <String fx:value="clinic-dashboard-card" />
                            <String fx:value="clinic-dashboard-card-primary" />
                        </styleClass>
                        <padding>
                            <Insets bottom="18" left="18" right="18" top="18" />
                        </padding>
                        <HBox spacing="12">
                            <StackPane maxHeight="46" maxWidth="46" minHeight="46" minWidth="46" prefHeight="46" prefWidth="46">
                                <styleClass>
                                    <String fx:value="clinic-icon-badge" />
                                    <String fx:value="clinic-icon-badge-primary" />
                                </styleClass>
                                <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2zm0 16H5V8h14v11zm0-13H5V5h14v1z" fill="#1D4ED8" scaleX="0.9" scaleY="0.9" />
                            </StackPane>
                            <VBox spacing="6">
                                <Label styleClass="clinic-dashboard-card-title" text="Clinic Schedule" />
                                <Label maxWidth="300" styleClass="clinic-dashboard-card-copy" text="Open the clinic scheduling interface." wrapText="true" />
                            </VBox>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Button maxWidth="Infinity" minHeight="40" onAction="#handleOpenSchedule" styleClass="primary-button" text="Open Schedule" />
                    </VBox>

                    <VBox maxWidth="520" minWidth="360" prefWidth="400" spacing="12" styleClass="clinic-dashboard-card">
                        <padding>
                            <Insets bottom="18" left="18" right="18" top="18" />
                        </padding>
                        <HBox spacing="12">
                            <StackPane maxHeight="46" maxWidth="46" minHeight="46" minWidth="46" prefHeight="46" prefWidth="46">
                                <styleClass>
                                    <String fx:value="clinic-icon-badge" />
                                    <String fx:value="clinic-icon-badge-patient" />
                                </styleClass>
                                <SVGPath content="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" fill="#9D174D" scaleX="0.9" scaleY="0.9" />
                            </StackPane>
                            <VBox spacing="6">
                                <Label styleClass="clinic-dashboard-card-title" text="Patient Treatments" />
                                <Label maxWidth="300" styleClass="clinic-dashboard-card-copy" text="Look up a patient by username and manage their treatment plan and prescriptions." wrapText="true" />
                            </VBox>
                        </HBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Button maxWidth="Infinity" minHeight="40" onAction="#handleManageTreatments" styleClass="secondary-button" text="Manage Treatments" />
                    </VBox>

                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets bottom="18" left="24" right="24" top="12" />
            </padding>
            <Label styleClass="clinic-footer-text" text="SafeX Clinic Portal" />
        </HBox>
    </bottom>

</BorderPane>
