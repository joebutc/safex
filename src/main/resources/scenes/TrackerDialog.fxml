<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="app.view.TrackerDialog" spacing="12"
            padding="24"
            prefWidth="420">

    <Label text="Log a New Test"
           style="-fx-font-size:16; -fx-font-weight:bold;"/>

    <Label text="Test Date"/>
    <DatePicker fx:id="datePicker"/>

    <Label text="Type of Test"/>
    <ComboBox fx:id="typeCombo"/>

    <Label text="Result"/>
    <ComboBox fx:id="resultCombo"/>

    <Label text="Notes (optional)"/>
    <TextArea fx:id="notesField"
              prefRowCount="3"
              wrapText="true"/>

    <Label fx:id="errorLabel"
           style="-fx-text-fill:#DC2626;"
           visible="false"/>

    <HBox spacing="10">
        <Button fx:id="cancelButton"
                text="Cancel"
                styleClass="secondary-button"
                HBox.hgrow="ALWAYS"/>

        <Button fx:id="saveButton"
                text="Save Test"
                styleClass="primary-button"
                HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>