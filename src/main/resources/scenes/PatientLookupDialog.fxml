<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="360"
      spacing="16"
      styleClass="dialog-shell"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.view.PatientLookupDialogController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Patient Lookup" styleClass="dialog-title"/>
    <Label text="Enter the patient's username to open their treatment plan."
           wrapText="true"
           styleClass="dialog-copy"/>
    <TextField fx:id="usernameField" promptText="Patient username"/>
    <Label fx:id="errorLabel"
           managed="false"
           visible="false"
           wrapText="true"
           styleClass="error-text"/>
    <HBox spacing="10">
        <Button onAction="#handleCancel" styleClass="secondary-button" text="Cancel"/>
        <Button fx:id="searchButton" onAction="#handleSearch" styleClass="primary-button" text="Open"/>
    </HBox>
</VBox>
