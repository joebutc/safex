<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" stylesheets="@../styles/app.css" xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.Schedule.CalendarController">
    <HBox prefHeight="35.0" prefWidth="581.0" styleClass="app-header">
        <Button mnemonicParsing="false" styleClass="icon-button">
            <graphic>
                <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../images/Home.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="57.0"
               prefWidth="508.0" styleClass="app-header-title" text="Doctors app.Schedule">
            <font>
                <Font name="System Bold" size="36.0"/>
            </font>
        </Label>
    </HBox>
    <HBox alignment="CENTER" prefHeight="58.0" prefWidth="581.0">
        <opaqueInsets>
            <Insets/>
        </opaqueInsets>
        <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                mnemonicParsing="false" onAction="#handlePreviousMonth" prefHeight="35.0" prefWidth="140.0"
                styleClass="secondary-button" text="Previous Month"/>
        <Label fx:id="monthLabel" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
               minHeight="-Infinity" minWidth="-Infinity" prefHeight="35.0" prefWidth="300.0" text="Current Month">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>
        <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                mnemonicParsing="false" onAction="#handleNextMonth" prefHeight="35.0" prefWidth="140.0"
                styleClass="secondary-button" text="Next Month"/>
    </HBox>
    <GridPane alignment="CENTER" gridLinesVisible="true">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                               prefWidth="50.0"/>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                               prefWidth="50.0"/>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                               prefWidth="50.0"/>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                               prefWidth="50.0"/>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                               prefWidth="50.0"/>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                               prefWidth="50.0"/>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity"
                               prefWidth="50.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints maxHeight="-Infinity" minHeight="-Infinity" prefHeight="40.0" vgrow="SOMETIMES"/>
        </rowConstraints>
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               prefHeight="19.0" prefWidth="39.0" text="Mon"/>
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               prefHeight="19.0" prefWidth="39.0" text="Tue" GridPane.columnIndex="1"/>
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               prefHeight="19.0" prefWidth="39.0" text="Wed" GridPane.columnIndex="2"/>
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               prefHeight="19.0" prefWidth="39.0" text="Thu" GridPane.columnIndex="3"/>
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               prefHeight="19.0" prefWidth="39.0" text="Fri" GridPane.columnIndex="4"/>
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               prefHeight="19.0" prefWidth="39.0" text="Sat" GridPane.columnIndex="5"/>
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               prefHeight="19.0" prefWidth="39.0" text="Sun" GridPane.columnIndex="6"/>
    </GridPane>
    <GridPane fx:id="calendarGrid" alignment="CENTER" gridLinesVisible="true" VBox.vgrow="ALWAYS">
      <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0"/>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0"/>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0"/>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0"/>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0"/>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0"/>
          <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0"/>
      </columnConstraints>
      <rowConstraints>
          <RowConstraints maxHeight="1.7976931348623157E308" minHeight="-Infinity" prefHeight="30.0" vgrow="ALWAYS"/>
          <RowConstraints maxHeight="1.7976931348623157E308" minHeight="-Infinity" prefHeight="30.0" vgrow="ALWAYS"/>
          <RowConstraints maxHeight="1.7976931348623157E308" minHeight="-Infinity" prefHeight="30.0" vgrow="ALWAYS"/>
          <RowConstraints maxHeight="1.7976931348623157E308" minHeight="-Infinity" prefHeight="30.0" vgrow="ALWAYS"/>
          <RowConstraints maxHeight="1.7976931348623157E308" minHeight="-Infinity" prefHeight="30.0" vgrow="ALWAYS"/>
          <RowConstraints maxHeight="1.7976931348623157E308" minHeight="-Infinity" prefHeight="30.0" vgrow="ALWAYS"/>
      </rowConstraints>
    </GridPane>
</VBox>
